# Environment files (secrets)
.env
.env.*
!.env.example
*.env.local
*.env.production
*.env.staging

# Per-stack service env files and mounted service-account keys are rendered on the
# VPS at deploy time and must never be committed (belt-and-suspenders alongside the
# deploy rsync --exclude rules).
**/credentials/sa-key.json

# Claude Code local settings (contains tokens)
.claude/

# MCP config (contains tokens — use .mcp.json.example as template)
.mcp.json

# SSH keys
*.pem
*.key
id_rsa*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Grafana data (generated at runtime)
monitoring/grafana/data/

# Prometheus data (generated at runtime)
monitoring/prometheus/data/

# Loki data
monitoring/loki/data/

# Terraform (if added later)
*.tfstate
*.tfstate.backup
.terraform/

# Node
node_modules/
package-lock.json
