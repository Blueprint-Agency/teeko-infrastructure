# Rendered by CI -> /root/stacks/n8n/.env.db-waba (service db-waba, container waba-db).
# Holds the WABA workflow data: users (279 rows) + flight_reminder.
#
# ⚠️ PGDATA IS LOAD-BEARING. waba_pgdata is mounted at /var/lib/postgresql/data, i.e.
# AT the data dir, not its parent -- unlike n8n_pgdata, which mounts the parent and
# lets the image pick /var/lib/postgresql/18/docker. Drop this line and Postgres uses
# its default layout, finds no data dir at the path it expects, and initialises a
# BRAND NEW EMPTY database rather than failing. The container then reports healthy
# and the 279 users are simply gone from view.
#
# This file was host-only until 2026-08-09: it existed on VPS3 and nowhere else, in no
# backup and no repo.
POSTGRES_USER=@@WABA_DB_USER@@
POSTGRES_PASSWORD=@@WABA_DB_PASSWORD@@
POSTGRES_DB=@@WABA_DB_NAME@@
PGDATA=/var/lib/postgresql/data
