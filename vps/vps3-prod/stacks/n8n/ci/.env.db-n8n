# Rendered by CI -> /root/stacks/n8n/.env.db-n8n (service db-n8n).
# ⚠️ Changing these does NOT rename an existing database. The volume n8n_pgdata is
# `external` and already initialised; POSTGRES_* only take effect on FIRST init.
POSTGRES_USER=@@N8N_DB_USER@@
POSTGRES_PASSWORD=@@N8N_DB_PASSWORD@@
POSTGRES_DB=@@N8N_DB_NAME@@
