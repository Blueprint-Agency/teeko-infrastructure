# Rendered by CI (vps/shared/render-ci.py) and written to /root/stacks/n8n/.env.n8n.
# Placeholders are filled from this host's GitHub Environment. Identical to VPS1's copy --
# the values differ per environment, the shape does not.
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=db-n8n
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_USER=@@N8N_DB_USER@@
DB_POSTGRESDB_PASSWORD=@@N8N_DB_PASSWORD@@
DB_POSTGRESDB_DATABASE=@@N8N_DB_NAME@@
DB_POSTGRESDB_SCHEMA=public
N8N_ENCRYPTION_KEY=@@N8N_ENCRYPTION_KEY@@
N8N_PORT=5678
N8N_EDITOR_BASE_URL=@@N8N_EDITOR_BASE_URL@@
WEBHOOK_URL=@@N8N_WEBHOOK_URL@@
N8N_SECURE_COOKIE=false
N8N_RUNNERS_ENABLED=true
N8N_DIAGNOSTICS_ENABLED=false
N8N_COMMUNITY_PACKAGES_ALLOW_TOOL_USAGE=true
N8N_DEFAULT_BINARY_DATA_MODE=filesystem
NODE_FUNCTION_ALLOW_BUILTIN=crypto
GENERIC_TIMEZONE=Asia/Kuala_Lumpur
TZ=Asia/Kuala_Lumpur
