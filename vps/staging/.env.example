# VPS1 Staging - Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# Traefik
ACME_EMAIL=your-email@example.com
BASE_DOMAIN=teeko.ai  # Root domain — subdomains like staging.teeko.ai, stagingapi.teeko.ai are derived from this
TRAEFIK_DASHBOARD_AUTH=admin:$$hashed_password  # Generate with: htpasswd -nb admin password

# Grafana
GRAFANA_ADMIN_PASSWORD=changeme

# App-specific vars will be added per app after migration audit
