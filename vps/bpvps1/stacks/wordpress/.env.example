# WordPress stack secrets — create these THREE files on the VPS at
# /root/stacks/wordpress/  (never commit the real values).
#
# ── .env  (docker compose interpolation; sets the Traefik Host rule) ──
WP_HOST=blog.kaiteki.my                # production (was blog.kaiteki.teeko.ai during staging)
#
# ── .env.wp-db  (MariaDB init) ──
MARIADB_DATABASE=kaitekim_blog2
MARIADB_USER=kaitekim_blog2
MARIADB_PASSWORD=__set_a_strong_password__
MARIADB_ROOT_PASSWORD=__set_a_strong_root_password__
#
# ── .env.wordpress  (WordPress -> DB) ──
WORDPRESS_DB_HOST=wp-db:3306
WORDPRESS_DB_NAME=kaitekim_blog2
WORDPRESS_DB_USER=kaitekim_blog2
WORDPRESS_DB_PASSWORD=__same_as_MARIADB_PASSWORD__
WORDPRESS_TABLE_PREFIX=kbsb_
