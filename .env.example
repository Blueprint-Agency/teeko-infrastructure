# Infrastructure Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.

# VPS Credentials (temporary — disable password auth once SSH keys are deployed)
VPS1_HOST=
VPS1_USER=root
VPS1_PASSWORD=

VPS2_HOST=
VPS2_USER=root
VPS2_PASSWORD=

VPS3_HOST=
VPS3_USER=root
VPS3_PASSWORD=

# GitHub MCP — each devops team member generates their own PAT
# Go to: github.com > Settings > Developer settings > Personal access tokens > Fine-grained tokens
# Required permissions:
#   Repository: Administration, Contents, Pull requests, Actions, Secrets, Workflows (read/write)
#   Organization: Members, Administration (read/write)
GITHUB_PERSONAL_ACCESS_TOKEN=

# Cloudflare MCP
# API Token: dash.cloudflare.com/profile/api-tokens → Create Token
#   Permissions: Zone:DNS:Edit, Zone:Zone:Read, Account:Account Settings:Read
#   Zone Resources: Include → teeko.ai
#   Client IP Filtering: leave empty (not supported by MCP)
# Account ID: dash.cloudflare.com → click any domain → right sidebar
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
