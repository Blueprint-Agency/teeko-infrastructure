# Copy to .env — NEVER commit .env to git.
# Grouped by vendor account. See "Two Accounts" in CLAUDE.md — Teeko and Blueprint
# share nothing, so never reuse a token across the two blocks.

# ─── Teeko account (teeko.ai) ────────────────────────────────────────────────
VPS1_HOST=
VPS1_USER=deploy
VPS1_PASSWORD=

VPS2_HOST=
VPS2_USER=deploy
VPS2_PASSWORD=

VPS3_HOST=
VPS3_USER=deploy
VPS3_PASSWORD=

# Hostinger API token for the Teeko account. Token exists and authenticates, but the account it
# belongs to is EMPTY — VPS1/2/3 are under a third login. No MCP server wired until that's resolved.
HOSTINGER_TEEKO_API_TOKEN=

# ─── Blueprint account (kaiteki.my / blueprintdigital.my / reservetoday.app) ──
BPVPS1_HOST=
BPVPS1_USER=root
BPVPS1_PASSWORD=

BPVPS2_HOST=
BPVPS2_USER=deploy
BPVPS2_PASSWORD=          # bootstrap only — rotate + blank after key auth is confirmed

# Hostinger API token — covers bpvps1 + bpvps2 only. Also paste into .mcp.json.
HOSTINGER_API_TOKEN=

# Cloudflare token for the Blueprint account. Despite the name it is NOT kaiteki-only —
# it covers all three Blueprint zones. Used by acme.sh on bpvps1 + bpvps2 (renew-cert.sh),
# so renaming it means editing on-host stack .env files. Left as-is deliberately.
KAITEKI_CF_DNS_API_TOKEN=

# ─── Account-agnostic ────────────────────────────────────────────────────────
# GitHub (PAT for curl/REST API — repo + org read/write)
GITHUB_PERSONAL_ACCESS_TOKEN=
