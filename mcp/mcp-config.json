{
  "_comment": "MCP Server Template — copy to .claude/settings.json. All secrets loaded from .env via wrapper scripts.",
  "mcpServers": {
    "ssh-manager": {
      "command": "npx",
      "args": ["-y", "mcp-ssh-manager"],
      "env": {
        "SSH_CONFIG_PATH": "~/.ssh/config"
      }
    },
    "docker-staging": {
      "command": "bash",
      "args": ["mcp/start-docker-mcp.sh", "staging"]
    },
    "docker-prod-vps2": {
      "command": "bash",
      "args": ["mcp/start-docker-mcp.sh", "prod-vps2"]
    },
    "docker-prod-vps3": {
      "command": "bash",
      "args": ["mcp/start-docker-mcp.sh", "prod-vps3"]
    },
    "github": {
      "command": "bash",
      "args": ["mcp/start-github-mcp.sh"]
    }
  }
}
